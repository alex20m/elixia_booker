# --- Discovery (local only, never deployed) ---
# Used by `npm run discover:headed` on your own machine. Copy to .env.
ELIXIA_EMAIL=you@example.com
ELIXIA_PASSWORD=your-password
ELIXIA_BASE_URL=https://www.elixia.fi

# --- App ---
# Copy these into .env.local for local dev; set them in Vercel for production.
# Full walkthrough: SETUP.md
#
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server-side only — bypasses row-level security
# ENCRYPTION_KEY=                        # openssl rand -base64 32
# CRON_SECRET=                           # openssl rand -base64 32
# TELEGRAM_BOT_TOKEN=                    # optional
# MOCK_ELIXIA=1                          # 0 once lib/elixia.ts is filled in
# DRY_RUN=1                              # 0 to actually book
# DEFAULT_BOOKING_WINDOW_DAYS=7          # 7 = Basic/Flexible, 14 = Premium
# DEFAULT_TIMEZONE=Europe/Helsinki
